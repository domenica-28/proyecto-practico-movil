generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MÓDULO ORGANIZACIONAL ---
model Organization {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(150)
  legalName         String?  @map("legal_name") @db.VarChar(200)
  taxIdentification String?  @map("tax_identification") @db.VarChar(30)
  status            String   @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  venues    Venue[]
  roles     Role[]
  userRoles UserRole[]

  @@map("organizations")
}

model Venue {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(150)
  status         String   @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  @@index([organizationId])
  @@map("venues")
}

// --- USUARIOS Y AUTENTICACIÓN ---
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(180)
  username     String?  @unique @db.VarChar(100)
  passwordHash String?  @map("password_hash") @db.Text
  status       String   @default("ACTIVO") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profile      UserProfile?
  authAccounts AuthAccount[]
  sessions     UserSession[]
  userRoles    UserRole[]
  pedidos      Pedido[]      // <--- Relación agregada: Un cliente tiene sus pedidos

  @@map("users")
}

model UserProfile {
  userId         String   @id @map("user_id") @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  identification String?  @db.VarChar(30)
  telefono       String?  @db.VarChar(20)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthAccount {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String @db.VarChar(50)
  providerAccountId String @map("provider_account_id") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// --- CONTROL DE ACCESO RBAC ---
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  code           String   @db.VarChar(100) // ej: "CLIENTE", "ADMIN_FLORERIA", "REPARTIDOR"
  name           String   @db.VarChar(150)
  isSystem       Boolean  @default(false) @map("is_system")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module String @db.VarChar(100)
  action String @db.VarChar(100)
  code   String @unique @db.VarChar(200)

  roles RolePermission[]
  menus MenuPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  roleId         String  @map("role_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  venueId        String? @map("venue_id") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId, venueId])
  @@map("user_roles")
}

// --- MENÚS DINÁMICOS ---
model Menu {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  code     String  @unique @db.VarChar(100)
  name     String  @db.VarChar(150)
  route    String? @db.VarChar(255)

  parent      Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Menu[]           @relation("MenuHierarchy")
  permissions MenuPermission[]

  @@map("menus")
}

model MenuPermission {
  menuId       String @map("menu_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([menuId, permissionId])
  @@map("menu_permissions")
}

// --- MÓDULO DE CATÁLOGO Y PEDIDOS ---
model Flores {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  descripcion String   @db.Text
  precio      Float
  stock       Int      @default(0)
  estado      Boolean  @default(true)
  imagenUrl   String?  @map("imagen_url")

  pedidos     Pedido[]

  @@map("flores")
}

model Pedido {
  id                 Int      @id @default(autoincrement())
  
  // Relación con el producto (Flor)
  florId             Int      @map("flor_id")
  flor               Flores   @relation(fields: [florId], references: [id])

  // Relación con el Cliente que hace la compra
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cantidad           Int
  precioTotal        Float    @map("precio_total")
  
  // --- NATIVOS SEMANA 14 (GPS Y CÁMARA / COMPROBANTE) ---
  tipoEntrega        String   @default("DOMICILIO") @db.VarChar(30) // "DOMICILIO" o "RETIRO_LOCAL"
  direccion          String?  @db.Text
  latitud            Float?   // Capturado con GPS para entregas a domicilio
  longitud           Float?   // Capturado con GPS para entregas a domicilio
  
  metodoPago         String   @default("TRANSFERENCIA") @db.VarChar(50) // "TRANSFERENCIA", "EFECTIVO", "TARJETA"
  comprobantePagoUrl String?  @map("comprobante_pago_url") @db.Text // <--- CÁMARA/GALERÍA: Foto del comprobante subida por el cliente

  // ESTADO DEL PEDIDO (Visibilidad para el cliente)
  // Opciones recomendadas: "Pendiente Pago", "Pago Verificado", "En Preparación", "Listo en Local", "En Camino", "Entregado"
  estado             String   @default("Pendiente Pago") @db.VarChar(50)
  visto              Boolean  @default(false)
  fecha              DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([florId])
  @@map("pedidos")
}
